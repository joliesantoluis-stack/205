
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">
    <title>FoodExpress - Food Ordering</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #fff8ef;
            color: #333;
        }

        header {
            background: #e85d24;
            color: white;
            text-align: center;
            padding: 25px;
        }

        nav {
            background: #333;
            padding: 15px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
        }

        .welcome {
            text-align: center;
            padding: 35px 15px;
        }

        .welcome h2 {
            color: #e85d24;
        }

        .menu {
            padding: 20px;
            text-align: center;
        }

        .food-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
        }

        .food {
            background: white;
            padding: 15px;
            width: 210px;
            border-radius: 12px;
            box-shadow: 0 2px 8px #ccc;
        }

        .food img {
            width: 100%;
            height: 140px;
            object-fit: cover;
            border-radius: 10px;
        }

        button {
            background: #e85d24;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 6px;
            cursor: pointer;
        }

        button:hover {
            background: #bd4215;
        }

        .cart, .order {
            background: white;
            margin: 20px auto;
            padding: 20px;
            max-width: 500px;
            border-radius: 10px;
        }

        input {
            width: 95%;
            padding: 10px;
            margin: 8px 0;
        }

        footer {
            background: #333;
            color: white;
            text-align: center;
            padding: 20px;
        }
    </style>
</head>

<body>

<header>
    <h1>🍔 FoodExpress</h1>
    <p>Order Your Favorite Food Online!</p>
</header>

<nav>
    <a href="#home">Home</a>
    <a href="#menu">Menu</a>
    <a href="#cart">My Cart</a>
    <a href="#contact">Contact</a>
</nav>

<section class="welcome" id="home">
    <h2>Welcome to FoodExpress!</h2>
    <p>Delicious food delivered to your door.</p>
</section>

<section class="menu" id="menu">
    <h2>Our Food Menu</h2>

    <div class="food-container">

        <div class="food">
            <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=500"
                 alt="Burger">
            <h3>Cheese Burger</h3>
            <p>₱99</p>
            <button onclick="addToCart('Cheese Burger', 99)">
                Add to Cart
            </button>
        </div>

        <div class="food">
            <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591?w=500"
                 alt="Pizza">
            <h3>Pizza</h3>
            <p>₱199</p>
            <button onclick="addToCart('Pizza', 199)">
                Add to Cart
            </button>
        </div>

        <div class="food">
            <img src="https://images.unsplash.com/photo-1573080496219-bb080dd4f877?w=500"
                 alt="French Fries">
            <h3>French Fries</h3>
            <p>₱59</p>
            <button onclick="addToCart('French Fries', 59)">
                Add to Cart
            </button>
        </div>

        <div class="food">
            <img src="https://images.unsplash.com/photo-1626082927389-6cd097cdc6ec?w=500"
                 alt="Fried Chicken">
            <h3>Fried Chicken</h3>
            <p>₱120</p>
            <button onclick="addToCart('Fried Chicken', 120)">
                Add to Cart
            </button>
        </div>

    </div>
</section>

<section class="cart" id="cart">
    <h2>🛒 My Shopping Cart</h2>
    <div id="cartItems">
        <p>Your cart is empty.</p>
    </div>
    <h3>Total: ₱<span id="total">0</span></h3>
</section>

<section class="order" id="contact">
    <h2>Customer Order Form</h2>

    <form onsubmit="placeOrder(event)">
        <input type="text" id="customer"
               placeholder="Enter your name" required>

        <input type="text" id="address"
               placeholder="Enter your delivery address" required>

        <button type="submit">Place Order</button>
    </form>

    <p id="message"></p>
</section>

<footer>
    <p>© 2026 FoodExpress</p>
    <p>Thank you for choosing FoodExpress!</p>
</footer>

<script>
    let cart = [];

    function addToCart(name, price) {
        cart.push({name: name, price: price});
        displayCart();
    }

    function displayCart() {
        let items = document.getElementById("cartItems");
        let total = 0;

        items.innerHTML = "";

        cart.forEach(function(item, index) {
            total += item.price;

            let row = document.createElement("p");
            row.textContent = item.name + " - ₱" +
                              item.price + " ";

            let remove = document.createElement("button");
            remove.textContent = "Remove";
            remove.onclick = function() {
                cart.splice(index, 1);
                displayCart();
            };

            row.appendChild(remove);
            items.appendChild(row);
        });

        if (cart.length === 0) {
            items.innerHTML = "<p>Your cart is empty.</p>";
        }

        document.getElementById("total").textContent = total;
    }

    function placeOrder(event) {
        event.preventDefault();

        if (cart.length === 0) {
            alert("Please add food to your cart first!");
            return;
        }

        let name = document.getElementById("customer").value;
        let address = document.getElementById("address").value;
        let total = cart.reduce((sum, item) =>
            sum + item.price, 0);

        alert(
            "Thank you, " + name +
            "! Your order has been placed.\n" +
            "Delivery Address: " + address +
            "\nTotal: ₱" + total
        );

        cart = [];
        displayCart();
        document.getElementById("customer").value = "";
        document.getElementById("address").value = "";
    }
</script>

</body>
</html>
